generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @unique @default(uuid())
  email          String           @unique
  password       String?
  name           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  Client         Client?
  Contacts       Contacts[]
  SentMessages   SentMessages[]
  Schedule       Schedule[]
  ContactCluster ContactCluster[]
  Trigger        Trigger[]
  Form                   Form[]
  ActivityLogs           ActivityLog[]
  CustomFieldDefinitions CustomFieldDefinition[]

  @@map("users")
}

model Client {
  id          Int      @id @unique @default(autoincrement())
  last_sync   DateTime @default(now())
  last_conn   DateTime @default(now())
  isConnected Boolean  @default(false)
  status      String   @default("DISCONNECTED") // DISCONNECTED, CONNECTING, QR_READY, CONNECTED, RECONNECTING, ERROR
  qr          String?
  phone       String?
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @unique
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("clients")
}

model Contacts {
  id              Int                      @id @default(autoincrement())
  phone           String
  name            String
  customFields    String?                  @default("{}") // JSON chave-valor dinâmico
  lastInteraction DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  userId          String
  User            User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clusterId       Int?                     // Legado mantido para compatibilidade
  Cluster         ContactCluster?          @relation(fields: [clusterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Clusters        ContactClusterRelation[]

  @@map("contacts")
}

model ContactCluster {
  id                     Int                      @id @default(autoincrement())
  name                   String
  description            String?
  userId                 String
  User                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Contacts               Contacts[]               // Legado
  ContactRelations       ContactClusterRelation[]
  TriggerClusterRelation TriggerClusterRelation[]

  @@map("contact_clusters")
}

model ContactClusterRelation {
  id        Int            @id @default(autoincrement())
  contactId Int
  clusterId Int
  Contact   Contacts       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Cluster   ContactCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([contactId, clusterId])
  @@map("contact_cluster_relations")
}

model CustomFieldDefinition {
  id        Int      @id @default(autoincrement())
  key       String   // e.g. empresa, cargo, ticket_medio, plano
  label     String   // Nome amigável exibido na interface
  type      String   @default("TEXT") // TEXT, NUMBER, CURRENCY, DATE, SELECT
  options   String?  // JSON array com opções caso seja SELECT
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@map("custom_field_definitions")
}

model SentMessages {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  phone     String

  @@map("sent_messages")
}

model Schedule {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  phone     String
  time      DateTime
  status    String   @default("PENDING") // PENDING, SENT, FAILED

  @@map("schedules")
}

model Step {
  id          Int    @id @default(autoincrement())
  question    String
  validations String
  stepNumber  Int
  formId      Int
  Form        Form   @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  key         String

  @@map("steps")
}

model Form {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Steps     Step[]

  @@map("forms")
}

model Trigger {
  id                      Int                       @id @default(autoincrement())
  kind                    String                    @default("REACTIVE") // REACTIVE (quando msg recebida) ou SCHEDULED (tempo/evento)
  name                    String                    @default("Automação")
  active                  Boolean                   @default(true)
  order                   Int                       @default(0)
  usageCount              Int                       @default(0)
  userId                  String
  User                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  delaySeconds            Int                       @default(0)
  actionType              String?                   // SEND_MESSAGE, ADD_CLUSTER, REMOVE_CLUSTER, MULTI_STEP
  actionConfig            String?                   // JSON com configurações extras
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  TemporalCondition       TemporalCondition?
  TextTrigger             TextTrigger[]
  ResponseTriggerRelation ResponseTriggerRelation[]
  TriggerClusterRelation  TriggerClusterRelation[]
  TriggerLog              TriggerLog[]

  @@map("triggers")
}

model TriggerLog {
  id        Int      @id @default(autoincrement())
  triggerId Int
  createdAt DateTime @default(now())
  Trigger   Trigger  @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@map("trigger_logs")
}

model ResponseLog {
  id         Int      @id @default(autoincrement())
  responseId Int
  createdAt  DateTime @default(now())
  Response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("response_logs")
}

model TextTrigger {
  id        Int     @id @default(autoincrement())
  text      String
  type      String  // EQUALS, REGEX, CONTAINS, STARTS_WITH, ENDS_WITH
  triggerId Int
  Trigger   Trigger @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("text_triggers")
}

model Response {
  id                      Int                       @id @default(autoincrement())
  type                    String                    @default("TEXTO") // TEXTO, IMAGEM, SEQUENCIA
  content                 String
  asMessage               Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  ResponseTriggerRelation ResponseTriggerRelation[]
  ResponseLog             ResponseLog[]

  @@map("responses")
}

model ResponseTriggerRelation {
  id         Int      @id @default(autoincrement())
  responseId Int
  triggerId  Int
  Response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Trigger    Trigger  @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("response_trigger_relations")
}

model TemporalCondition {
  id           Int       @id @default(autoincrement())
  type         String    @default("SPECIFIC_TIME") // SPECIFIC_TIME, RECURRING_DAILY, INACTIVITY_DAYS, ON_CLUSTER_ENTER
  cron         String?
  inactivityDays Int?
  targetTime   String?   // HH:mm
  initial_date DateTime?
  final_date   DateTime?
  triggerId    Int       @unique
  Trigger      Trigger   @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("temporal_conditions")
}

model TriggerClusterRelation {
  id               Int            @id @default(autoincrement())
  triggerId        Int
  Trigger          Trigger        @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  triggerClusterId Int
  TriggerCluster   ContactCluster @relation(fields: [triggerClusterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  included         Boolean        @default(true) // true = se estiver no cluster; false = se NÃO estiver

  @@map("trigger_cluster_relations")
}

model ActivityLog {
  id             Int      @id @default(autoincrement())
  userId         String
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactPhone   String?
  contactName    String?
  eventType      String   // WPP_CONNECT, WPP_DISCONNECT, MSG_RECEIVED, MSG_SENT, CONTACT_CREATED, CLUSTER_ADDED, REACTIVE_TRIGGERED, TRIGGER_EXECUTED, ERROR
  description    String
  automationType String?  // REACTIVE, TRIGGER, MANUAL, SYSTEM
  automationId   Int?
  status         String   @default("SUCCESS") // SUCCESS, ERROR, INFO, WARNING
  metadata       String?  // JSON string
  createdAt      DateTime @default(now())

  @@map("activity_logs")
}
