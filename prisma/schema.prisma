model Trigger {
  id                      Int                       @id @default(autoincrement())
  active                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  name                    String                    @default("Gatilho")
  order                   Int                       @default(0)
  usageCount              Int                       @default(0)
  userId                  String
  count_used              Int                       @default(0)
  User                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Responses               Response[]
  TemporalCondition       TemporalCondition?
  // TriggerClusters         TriggerCluster[]
  TextTrigger             TextTrigger[]
  ResponseTriggerRelation ResponseTriggerRelation[]
  TriggerClusterRelation  TriggerClusterRelation[]
  TriggerLog              TriggerLog[]

  @@map("triggers")
}

model TriggerLog {
  id        Int      @id @default(autoincrement())
  triggerId Int
  createdAt DateTime @default(now())
  Trigger   Trigger  @relation(fields: [triggerId], references: [id], onDelete: NoAction)

  @@map("trigger_logs")
}

model ResponseLog {
  id         Int      @id @default(autoincrement())
  responseId Int
  createdAt  DateTime @default(now())
  Response   Response @relation(fields: [responseId], references: [id], onDelete: NoAction)

  @@map("response_logs")
}

model TextTrigger {
  id        Int     @id @default(autoincrement())
  text      String
  triggerId Int
  Trigger   Trigger @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type      String // ('EQUALS', 'REGEX', 'CONTAINS', 'STARTS_WITH', 'END_WITH')
}

model Response {
  id                      Int                       @id @default(autoincrement())
  type                    String // ('TEXTO', 'IMAGEM', etc.) OU ativar um form
  content                 String
  asMessage               Boolean                   @default(true)
  // triggerId    Int
  // Trigger      Trigger @relation(fields: [triggerId], references: [id])
  createdAt               DateTime                  @default(now())
  // timesReplied            Int                       @default(0)
  // Trigger                 Trigger?                  @relation(fields: [triggerId], references: [id])
  // triggerId               Int?
  ResponseTriggerRelation ResponseTriggerRelation[]
  ResponseLog             ResponseLog[]

  @@map("responses")
}

model ResponseTriggerRelation {
  id         Int      @id @default(autoincrement())
  responseId Int
  triggerId  Int
  Response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Trigger    Trigger  @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("response_trigger_relations")
}

model TemporalCondition {
  id           Int       @id @default(autoincrement())
  initial_date DateTime?
  final_date   DateTime?
  initial_time String?
  final_time   String?
  triggerId    Int       @unique
  Trigger      Trigger   @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  as           String // (DATE, TIME)

  @@map("temporal_conditions")
}

model TriggerClusterRelation {
  id               Int            @id @default(autoincrement())
  triggerId        Int
  Trigger          Trigger        @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  triggerClusterId Int
  TriggerCluster   ContactCluster @relation(fields: [triggerClusterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  included         Boolean        @default(true)

  @@map("trigger_cluster_relations")
}

model TriggerCluster {
  id        Int            @id @default(autoincrement())
  // triggerId Int
  inside    Boolean        @default(true) // Se o trigger é para quem está dentro ou fora do cluster
  clusterId Int
  // Trigger   Trigger[]        @relation(fields: [triggerId], references: [id])
  Cluster   ContactCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Trigger   Trigger        @relation(fields: [triggerId], references: [id])

  @@map("trigger_clusters")
}
