model Contacts {
  id        Int             @id @default(autoincrement())
  phone     String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  userId    String
  User      User            @relation(fields: [userId], references: [id])
  clusterId Int?
  Cluster   ContactCluster? @relation(fields: [clusterId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("contacts")
}

model ContactCluster {
  id                     Int                      @id @default(autoincrement())
  name                   String
  userId                 String
  User                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  description            String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Contacts               Contacts[]
  TriggerCluster         TriggerCluster[]
  TriggerClusterRelation TriggerClusterRelation[]
}

model SentMessages {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  phone     String

  @@map("sent_messages")
}

model Schedule {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  phone     String
  time      DateTime

  @@map("schedules")
}

model Step {
  id          Int    @id @default(autoincrement())
  question    String
  validations String // JSON?
  stepNumber  Int
  formId      Int
  Form        Form   @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  key         String
}

model Form {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Steps     Step[]

  @@map("forms")
}

