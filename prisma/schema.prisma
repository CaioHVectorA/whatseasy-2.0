model Trigger {
  id                Int                @id @default(autoincrement())
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  order             Int                @default(0)
  userId            String
  User              User               @relation(fields: [userId], references: [id])
  Responses         Response[]
  TemporalCondition TemporalCondition?
  TriggerClusters   TriggerCluster[]
  TextTrigger       TextTrigger[]

  @@map("triggers")
}

model TextTrigger {
  id        Int     @id @default(autoincrement())
  text      String
  triggerId Int
  Trigger   Trigger @relation(fields: [triggerId], references: [id])
  type      String // ('EQUALS', 'REGEX', 'CONTAINS', 'STARTS_WITH', 'END_WITH')
}

model Response {
  id        Int      @id @default(autoincrement())
  type      String // ('TEXTO', 'IMAGEM', etc.) OU ativar um form
  content   String
  triggerId Int
  Trigger   Trigger  @relation(fields: [triggerId], references: [id])
  createdAt DateTime @default(now())

  @@map("responses")
}

model TemporalCondition {
  id           Int      @id @default(autoincrement())
  description  String
  initial_date DateTime
  final_date   DateTime
  triggerId    Int      @unique
  Trigger      Trigger  @relation(fields: [triggerId], references: [id])

  @@map("temporal_conditions")
}

model TriggerCluster {
  id        Int            @id @default(autoincrement())
  triggerId Int
  inside    Boolean        @default(true) // Se o trigger é para quem está dentro ou fora do cluster
  clusterId Int
  Trigger   Trigger        @relation(fields: [triggerId], references: [id])
  Cluster   ContactCluster @relation(fields: [clusterId], references: [id])

  @@map("trigger_clusters")
}
