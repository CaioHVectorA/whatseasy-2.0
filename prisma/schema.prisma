generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  password        String
  last_connection DateTime?
  last_sync       DateTime?
  isConnected     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  Reactive        Reactive[]
  Contacts        Contacts[]
  SentMessages    SentMessages[]
  Schedule        Schedule[]
  ContactCluster  ContactCluster[]

  @@map("users")
}

model Reactive {
  id        Int      @id @default(autoincrement())
  message   String
  response  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id])

  @@map("reactives")
}

model Contacts {
  id        Int             @id @default(autoincrement())
  phone     String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  userId    String
  User      User            @relation(fields: [userId], references: [id])
  clusterId Int?
  Cluster   ContactCluster? @relation(fields: [clusterId], references: [id])

  @@map("contacts")
}

model ContactCluster {
  id          Int        @id @default(autoincrement())
  name        String
  userId      String
  User        User       @relation(fields: [userId], references: [id])
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Contacts    Contacts[]
}

model SentMessages {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id])
  phone     String

  @@map("sent_messages")
}

model Schedule {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id])
  phone     String
  time      DateTime

  @@map("schedules")
}

