generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @unique @default(uuid())
  email          String           @unique
  name           String?
  // password       String -> changed to magic link
  // last_connection DateTime?
  // last_sync       DateTime?
  // isConnected     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  // Reactive       Reactive[]
  client_id      Int?
  Client         Client?
  Contacts       Contacts[]
  SentMessages   SentMessages[]
  Schedule       Schedule[]
  ContactCluster ContactCluster[]
  Trigger        Trigger[]
  Form           Form[]

  @@map("users")
}

model Client {
  id          Int         @id @unique @default(autoincrement())
  last_sync   DateTime    @default(now())
  last_conn   DateTime    @default(now())
  isConnected Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String      @unique
  qr          String
  User        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clientLog   ClientLog[]

  @@map("clients")
}

model ClientLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientId  Int
  Client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type      String // (CONNECTED, DISCONNECT, RECONNECT, HEARTBEAT)

  @@map("client_connections")
}

