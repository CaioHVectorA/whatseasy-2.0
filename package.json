{
  "name": "whatseasy-2.0",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@flydotio/dockerfile": "^0.5.9",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.27",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "prisma": "^5.19.1",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"tsx watch index.ts\" \"npm --prefix apps/dashboard run dev\"",
    "dev:server": "tsx watch index.ts",
    "dev:web": "npm --prefix apps/dashboard run dev",
    "dev:bun": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"bun --watch index.ts\" \"npm --prefix apps/dashboard run dev\"",
    "build": "prisma generate && npm --prefix apps/dashboard run build",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^10.0.0",
    "@prisma/client": "^5.19.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcrypt": "^5.1.1",
    "fastify": "^4.28.1",
    "pino": "^9.3.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
